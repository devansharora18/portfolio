% Sections formatting - improved spacing
\titleformat{\section}{
  \vspace{-10pt}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]

% Ensure that generate pdf is machine readable/ATS parsable
\pdfgentounicode=1

%-------------------------
% Custom commands with optimized spacing
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2.7pt}}
  }
}

\newenvironment{header}{
    \setlength{\topsep}{0pt}\par\kern\topsep\centering\color{CustomPurple}\linespread{1.15}
}{
    \par\kern\topsep
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2.8pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-6pt}
}

\newcommand{\resumeSubSubheading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \textit{\small#1} & \textit{\small #2} \\
    \end{tabular*}\vspace{-6pt}
}

\newcommand{\resumeProjectHeading}[3]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 \hspace{0.2cm} #3 & #2 \\
    \end{tabular*}\vspace{-6pt}
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}\vspace{-2.5pt}}
\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}
\newcommand{\resumeSubHeadingListStart}{
  \vspace{-1pt} % Reduce top margin when starting a new section list
  \begin{itemize}[leftmargin=0.15in, label={}, itemsep=1pt]
}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[itemsep=1.5pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-4pt}}

% Fixed href command with SMALLER external link symbol
\let\hrefWithoutArrow\href
\renewcommand{\href}[2]{\hrefWithoutArrow{#1}{\underline{#2}\,\raisebox{.15ex}{\scriptsize \faExternalLink*}} }

